# Development Dockerfile with hot reload
FROM maven:3.9-eclipse-temurin-21

WORKDIR /workspace

# Copy reactor + module poms
COPY pom.xml .
COPY fogui-java-core/pom.xml fogui-java-core/pom.xml
COPY fogui-spring-starter/pom.xml fogui-spring-starter/pom.xml
COPY backend-java/pom.xml backend-java/pom.xml

# Copy source trees
COPY fogui-java-core/src fogui-java-core/src
COPY fogui-spring-starter/src fogui-spring-starter/src
COPY backend-java/src backend-java/src

# Expose port and debug port
EXPOSE 5001 5005

# Enable JDWP for VS Code attach debugging in the dev container.
ENV SPRING_BOOT_RUN_JVM_ARGS="-Dspring.devtools.restart.enabled=true -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"

# Install the local reactor first, then launch only the backend module.
CMD ["sh", "-c", "mvn -q -DskipTests -pl backend-java -am install && mvn -f backend-java/pom.xml spring-boot:run -Dspring-boot.run.jvmArguments=\"$SPRING_BOOT_RUN_JVM_ARGS\""]
