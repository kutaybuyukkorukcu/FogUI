# FogUI App Environment Configuration
# Copy this file to .env when running the local demo apps or Docker Compose stack.
# Package consumers do not need this file.

# ===========================================
# OpenAI-Compatible Configuration (Groq, OpenRouter, OpenAI)
# ===========================================
# The showcase backend currently supports OpenAI-compatible providers only.
OPENAI_API_KEY=sk-your-provider-api-key
GROQ_API_KEY=gsk_your-groq-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai
OPENAI_MODEL=llama-3.3-70b-versatile

# OpenRouter (alternative)
# OPENAI_API_KEY=sk-or-your-openrouter-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenAI (alternative)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

