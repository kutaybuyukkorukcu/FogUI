# FogUI App Environment Configuration
# Copy this file to .env when running the local demo apps or Docker Compose stack.
# Package consumers do not need this file.

# ===========================================
# PostgreSQL Container Configuration
# ===========================================
POSTGRES_DB=fogui
POSTGRES_USER=fogui
POSTGRES_PASSWORD=your-secure-database-password

# ===========================================
# Backend Database Configuration
# ===========================================
DATABASE_URL=jdbc:postgresql://localhost:5432/fogui
DATABASE_USER=fogui
DATABASE_PASSWORD=your-secure-database-password

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRATION_HOURS=24

# ===========================================
# OpenAI-Compatible Configuration (Groq, OpenRouter, OpenAI)
# ===========================================
# The backend currently supports OpenAI-compatible providers only.
OPENAI_API_KEY=sk-your-provider-api-key
GROQ_API_KEY=gsk_your-groq-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai
OPENAI_MODEL=llama-3.3-70b-versatile

# OpenRouter (alternative)
# OPENAI_API_KEY=sk-or-your-openrouter-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenAI (alternative)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ===========================================
# Sentry Error Monitoring
# ===========================================
# Optional backend Sentry settings

# Backend (Java Spring Boot) - Sentry Project: java-spring-boot
SENTRY_DSN=https://your-backend-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# CI/CD Source Upload (used in GitHub Actions)
# Get auth token from sentry.io -> Settings -> Auth Tokens
# SENTRY_AUTH_TOKEN=sntrys_eyJ...
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT_BACKEND=java-spring-boot
