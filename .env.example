# FogUI Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=jdbc:postgresql://localhost:5432/fogui
DATABASE_USER=fogui
DATABASE_PASSWORD=your-secure-database-password

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRATION_HOURS=24

# ===========================================
# LLM Provider Selection
# ===========================================
# Choose provider: "openai" (for Groq/OpenRouter/OpenAI) or "gemini"
AI_PROVIDER=openai

# ===========================================
# OpenAI-Compatible Configuration (Groq, OpenRouter, OpenAI)
# ===========================================
# Use when AI_PROVIDER=openai
GROQ_API_KEY=gsk_your-groq-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai
OPENAI_MODEL=llama-3.3-70b-versatile

# OpenRouter (alternative)
# OPENAI_API_KEY=sk-or-your-openrouter-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenAI (alternative)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ===========================================
# Google Gemini Configuration
# ===========================================
# Use when AI_PROVIDER=gemini
GOOGLE_AI_API_KEY=your-google-ai-api-key
GOOGLE_AI_MODEL=gemini-2.5-flash
