# FogUI Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=jdbc:postgresql://localhost:5432/fogui
DATABASE_USER=fogui
DATABASE_PASSWORD=your-secure-database-password

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRATION_HOURS=24

# ===========================================
# LLM Provider Selection
# ===========================================
# Choose provider: "openai" (for Groq/OpenRouter/OpenAI) or "gemini"
AI_PROVIDER=openai

# ===========================================
# OpenAI-Compatible Configuration (Groq, OpenRouter, OpenAI)
# ===========================================
# Use when AI_PROVIDER=openai
GROQ_API_KEY=gsk_your-groq-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai
OPENAI_MODEL=llama-3.3-70b-versatile

# OpenRouter (alternative)
# OPENAI_API_KEY=sk-or-your-openrouter-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenAI (alternative)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ===========================================
# Google Gemini Configuration
# ===========================================
# Use when AI_PROVIDER=gemini
GOOGLE_AI_API_KEY=your-google-ai-api-key
GOOGLE_AI_MODEL=gemini-2.5-flash

# ===========================================
# Sentry Error Monitoring
# ===========================================
# Create 2 projects in Sentry: one for Java Spring Boot, one for React
# Get your DSN from sentry.io -> Project Settings -> Client Keys (DSN)

# Backend (Java Spring Boot) - Sentry Project: java-spring-boot
SENTRY_DSN=https://your-backend-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# Frontend (React Dashboard) - Sentry Project: react
VITE_SENTRY_DSN=https://your-frontend-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=development

# CI/CD Source Upload (used in GitHub Actions)
# Get auth token from sentry.io -> Settings -> Auth Tokens
# SENTRY_AUTH_TOKEN=sntrys_eyJ...
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT_BACKEND=java-spring-boot
# SENTRY_PROJECT_FRONTEND=javascript-react
